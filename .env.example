# ===========================================
# Git Configuration
# ===========================================
GIT_USER_NAME=
GIT_USER_EMAIL=

# ===========================================
# Project Configuration
# ===========================================
PROJECT_ROOT=/target
PROJECT_GOAL=プロジェクトの目標を設定してください
TARGET_PROJECT=

# ===========================================
# LLM Backend Configuration
# ===========================================
# Default backend: cursor_cli, claude_code_cli, gemini_cli
LLM_BACKEND=cursor_cli
LLM_OUTPUT_FORMAT=text

# Per-agent backend configuration with fallback
# Format: "backend1:model1,backend2:model2,..."
# Example: "claude_code_cli:opus,cursor_cli" (Cursor uses its default model)
PLANNER_BACKENDS=
WORKER_BACKENDS=
JUDGE_BACKENDS=

# Per-backend default models
CURSOR_CLI_MODEL=
CLAUDE_CODE_CLI_MODEL=
GEMINI_CLI_MODEL=

# ===========================================
# Dynamic Model Selection (Worker only)
# ===========================================
# When enabled, Worker selects model tier based on task complexity
MODEL_SELECTION_ENABLED=false
MODEL_COMPLEXITY_THRESHOLD_LIGHT=10.0
MODEL_COMPLEXITY_THRESHOLD_POWERFUL=30.0

# Per-backend dynamic models
# Cursor CLI
CURSOR_CLI_MODEL_LIGHT=
CURSOR_CLI_MODEL_STANDARD=
CURSOR_CLI_MODEL_POWERFUL=

# Claude Code CLI
CLAUDE_CODE_CLI_MODEL_LIGHT=
CLAUDE_CODE_CLI_MODEL_STANDARD=
CLAUDE_CODE_CLI_MODEL_POWERFUL=

# Gemini CLI
GEMINI_CLI_MODEL_LIGHT=
GEMINI_CLI_MODEL_STANDARD=
GEMINI_CLI_MODEL_POWERFUL=

# Backend availability check (skip unavailable backends)
CHECK_BACKEND_AVAILABILITY=true

# ===========================================
# Execution Configuration
# ===========================================
WAIT_TIME_SECONDS=60
MAX_ITERATIONS=100
MAX_RETRIES=3
MAX_PLAN_REVISIONS=3

# Plan_Judge 判定ライン: score がこの値未満のときは accept を revise に上書き（0.0 = 無効）
# 例: 0.6 にすると、LLM が accept を返しても score < 0.6 なら revise 扱いになる
PLAN_JUDGE_ACCEPT_THRESHOLD=0.0

# Parallel execution
ENABLE_PARALLEL_EXECUTION=true
MAX_PARALLEL_WORKERS=3

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=INFO
LOG_FSYNC=false

# ===========================================
# Dashboard Configuration
# ===========================================
DASHBOARD=false
