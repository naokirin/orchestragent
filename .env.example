# Git Configuration for commits inside Docker container
# Values set here are applied to git user.name / user.email inside the container.
# Example:
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com
GIT_USER_NAME=
GIT_USER_EMAIL=

# Project Configuration
# Working Directory (Guest machine path)
PROJECT_ROOT=/target
PROJECT_GOAL=プロジェクトの目標を設定してください

# Target Project Path (Host machine path)
# Cursor CLI inside this Docker container has full permissions.
# - Back up important files beforehand
# - Do not mount production directories
# - Prefer mounting a working copy when possible
TARGET_PROJECT=

# For docker-compose.exec.yml: host paths for state / logs / docs/adr (absolute paths recommended).
# With Compose v2 -f, relative paths are resolved from the compose file directory;
# use absolute paths when running from outside that directory.
# ORCHESTRAGENT_STATE_DIR=
# ORCHESTRAGENT_LOG_DIR=
# ORCHESTRAGENT_ADR_DIR=

# LLM Configuration
LLM_BACKEND=cursor_cli
LLM_OUTPUT_FORMAT=text

# Default Agent Model Configuration
# You can find out which agent models can be specified using the following command.
# cursor: docker compose run --rm agent agent --list-models
LLM_MODEL=auto  # Optional: default model for all agents

# Agent-specific Model Configuration
# Each agent can have its own default model
# Falls back to LLM_MODEL if not set, then to Cursor CLI default
# PLANNER_MODEL=gpt-5  # Model for Planner agent
# WORKER_MODEL=gpt-4  # Default model for Worker agents
# JUDGE_MODEL=gpt-4  # Model for Judge agent

# Dynamic Model Selection for Workers
# These models are used when dynamic selection is enabled
# WORKER_MODEL_LIGHT=gpt-4  # For simple tasks (complexity < threshold_light)
# WORKER_MODEL_STANDARD=gpt-5  # For standard tasks
# WORKER_MODEL_POWERFUL=gpt-5  # For complex tasks (complexity >= threshold_powerful)

# Model Selection Configuration
# MODEL_SELECTION_ENABLED=false  # Enable dynamic model selection for workers
# MODEL_COMPLEXITY_THRESHOLD_LIGHT=10.0  # Complexity threshold for light model
# MODEL_COMPLEXITY_THRESHOLD_POWERFUL=30.0  # Complexity threshold for powerful model

# ===========================================
# Multi-CLI Backend Configuration (Fallback Support)
# ===========================================
# Supported backends: cursor_cli, claude_code_cli, gemini_cli
#
# Per-agent backend configuration with fallback
# Format: "backend1:model1,backend2:model2,..."
# If model is omitted, falls back to: backend-specific -> agent-specific -> global model
#
# Example: Try Claude Code CLI first, fall back to Cursor CLI
# PLANNER_BACKENDS=claude_code_cli:opus,cursor_cli:claude-3-5-sonnet
# WORKER_BACKENDS=cursor_cli:claude-3-5-sonnet,gemini_cli:gemini-2.5-pro
# JUDGE_BACKENDS=gemini_cli:gemini-2.5-flash
PLANNER_BACKENDS=
WORKER_BACKENDS=
JUDGE_BACKENDS=

# Per-backend default models (used when model is omitted in *_BACKENDS)
# CURSOR_CLI_MODEL=claude-3-5-sonnet
# CLAUDE_CODE_CLI_MODEL=opus
# GEMINI_CLI_MODEL=gemini-2.5-pro

# Per-backend dynamic model selection
# Each backend can have its own light/standard/powerful models for Worker agents
# When MODEL_SELECTION_ENABLED=true, the system selects model tier based on task complexity
# and each backend resolves to its own tier-specific model
#
# Cursor CLI dynamic models
# CURSOR_CLI_MODEL_LIGHT=gpt-4
# CURSOR_CLI_MODEL_STANDARD=claude-3-5-sonnet
# CURSOR_CLI_MODEL_POWERFUL=claude-3-5-sonnet
#
# Claude Code CLI dynamic models
# CLAUDE_CODE_CLI_MODEL_LIGHT=haiku
# CLAUDE_CODE_CLI_MODEL_STANDARD=sonnet
# CLAUDE_CODE_CLI_MODEL_POWERFUL=opus
#
# Gemini CLI dynamic models
# GEMINI_CLI_MODEL_LIGHT=gemini-2.5-flash
# GEMINI_CLI_MODEL_STANDARD=gemini-2.5-pro
# GEMINI_CLI_MODEL_POWERFUL=gemini-2.5-pro

# Backend availability check
# true: Skip unavailable backends in fallback chain
# false: Try all configured backends
CHECK_BACKEND_AVAILABILITY=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FSYNC=false

# Main Loop Configuration
WAIT_TIME_SECONDS=60
MAX_ITERATIONS=100

# Dashboard Configuration
# Set to true/1/on to enable dashboard mode (interactive UI)
DASHBOARD=false

# Error Handling Configuration
MAX_RETRIES=3

# Planning Review Configuration
# Maximum number of plan revisions per iteration (Planner + Plan_Judge).
# If Plan_Judge does not accept the plan within this count, the run is treated as failed and the agent system exits.
MAX_PLAN_REVISIONS=3

# Parallel Execution Configuration
MAX_PARALLEL_WORKERS=3
ENABLE_PARALLEL_EXECUTION=true
