                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "YBmqs",
                  "name": "adr1Context",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "Qdska",
                      "name": "adr1ContextLabel",
                      "fill": "#a0aec0",
                      "content": "コンテキスト",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "uQBgm",
                      "name": "adr1ContextText",
                      "fill": "#c0c0c0",
                      "content": "ユーザー認証機能の実装にあたり、セッション管理方式を決定する必要がある。スケーラビリティとセキュリティを考慮した選択が求められる。",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Y4uHH",
                  "name": "adr1Decision",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "b97MO",
                      "name": "adr1DecisionLabel",
                      "fill": "#a0aec0",
                      "content": "決定",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "HCDtX",
                      "name": "adr1DecisionText",
                      "fill": "#c0c0c0",
                      "content": "JWT (JSON Web Token) を使用したステートレス認証を採用する。トークンの有効期限は24時間とし、リフレッシュトークンによる更新を行う。",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "K2CvE",
                  "name": "adr1Reason",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "huagy",
                      "name": "adr1ReasonLabel",
                      "fill": "#a0aec0",
                      "content": "理由",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "m0Hyk",
                      "name": "adr1ReasonText",
                      "fill": "#c0c0c0",
                      "content": "ステートレス認証により水平スケーリングが容易になり、サーバー間でのセッション共有が不要となる。また、モバイルアプリやSPAとの親和性が高く、将来的な拡張にも対応しやすい。",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RHaDX",
                  "name": "adr1Consequence",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 8,
                  "children": [
                    {
                      "type": "text",
                      "id": "o3rPl",
                      "name": "adr1ConsequenceLabel",
                      "fill": "#a0aec0",
                      "content": "結果",
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "bold"
                    },
                    {
                      "type": "text",
                      "id": "pXSPs",
                      "name": "adr1ConsequenceText",
                      "fill": "#c0c0c0",
                      "content": "トークン管理のためのミドルウェア実装が必要となった。また、トークン失効時の即座な無効化が難しいため、ブラックリスト機構を別途検討する必要がある。",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "ym2e5",
